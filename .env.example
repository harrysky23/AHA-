# Copy to .env. Never put keys in frontend/ or share the real key in chat.
AHA_AI_PROVIDER=mock

# Google AI Studio Developer API key. Server only; do not use a Vertex key.
# Free tier availability/quota is project-specific. This app cannot verify billing tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=45

# Local output cache, not Google's paid context cache. 0 disables caching.
AHA_CACHE_TTL_SECONDS=300
AHA_CACHE_MAX_ENTRIES=64

# Provider choices: mock (fixed demo), gemini (real API), elice (not connected).
# Legacy AHA_AI_MODE is accepted only as an alias; avoid conflicting settings.
# Elice has no network implementation until its actual API specification is confirmed.
