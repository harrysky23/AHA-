# Copy to .env. Never put keys in frontend/ or share the real key in chat.
AHA_AI_PROVIDER=mock

# Google AI Studio Developer API key. Server only; do not use a Vertex key.
# Free tier availability/quota is project-specific. This app cannot verify billing tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096
# Separate output budget for storyboard JSON (Phase 3-A); does not change HTML.
STORYBOARD_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_SECONDS=45

# Local output cache, not Google's paid context cache. 0 disables caching.
AHA_CACHE_TTL_SECONDS=300
AHA_CACHE_MAX_ENTRIES=64

# Provider choices: mock (fixed demo), gemini (real API), elice (not connected).
# Legacy AHA_AI_MODE is accepted only as an alias; avoid conflicting settings.
# Elice has no network implementation until its actual API specification is confirmed.

# Phase 3-C local video queue. Restart applies these settings and clears old jobs.
# Run one server process (--workers 1). Browser/TTS/FFmpeg are local dependencies.
AHA_VIDEO_QUEUE_LIMIT=3
AHA_VIDEO_MAX_JOBS=16
AHA_VIDEO_TTL_SECONDS=3600
AHA_VIDEO_RUN_SECONDS=900
AHA_VIDEO_STORAGE_MB=2048
# Default web video: 1080x1920/30fps. For development: true and 3.
AHA_VIDEO_PREVIEW=false
AHA_VIDEO_FPS=30
# svg keeps the existing FFmpeg renderer; remotion adds React frame rendering.
AHA_VIDEO_RENDERER=svg
AHA_VIDEO_RENDER_TIMEOUT_SECONDS=600
AHA_VIDEO_MAX_DISK_MB=512

# Phase 3-D experimental media providers. Not automatically used by the web queue.
# Keys stay on the backend. Never commit the real .env.
CHATKHU_API_KEY=
AHA_INTERACTIVE_PROVIDER=claude
AHA_INTERACTIVE_CLAUDE_MODEL=claude-opus-5-5
CHATKHU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
CHATKHU_IMAGE_MODEL=gemini-3.1-flash-lite-image
CHATKHU_VIDEO_MODEL=fal-ai/kling-video/v3
CHATKHU_TTS_MODEL=gemini-3.1-flash-tts-preview

# ChatKHU models for opt-in generated Remotion shorts
VIDEO_CODE_MODEL=claude-opus-5-5
VIDEO_REPAIR_MODEL=claude-opus-5-5
