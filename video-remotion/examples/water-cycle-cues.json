  "captions": [
    {"start_seconds":1.27,"end_seconds":4.1,"text":"태양 에너지를 받은 바다의 물 일부는"},
    {"start_seconds":4.1,"end_seconds":7.25,"text":"수증기가 되어 공기 중으로 이동해요."},
    {"start_seconds":7.25,"end_seconds":8.7,"text":"수증기가 식으면"},
